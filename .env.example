# Runpod
RUNPOD_API_KEY=
RUNPOD_CLOUD_TYPE=COMMUNITY
RUNPOD_GPU_TYPE_IDS=NVIDIA H200
RUNPOD_GPU_COUNT=8
RUNPOD_DATA_CENTER_IDS=
RUNPOD_POD_NAME=glm51-runpod-r2-cold-r2-cold
RUNPOD_IMAGE_NAME=ghcr.io/your-user/glm51-runpod-r2-cold:latest
# Optional for private registries
RUNPOD_CONTAINER_REGISTRY_AUTH_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional Hugging Face auth for gated or rate-limited pulls
HF_TOKEN=

# Model and workflow controls
MODEL_ID=zai-org/GLM-5.1-FP8
LIVE_DEPLOY=0
AUTO_MIRROR_TO_R2=1
